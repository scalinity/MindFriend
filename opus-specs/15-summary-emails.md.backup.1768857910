## 9. Edge Functions

### 8.1 send-email (CRITICAL)

```typescript
// supabase/functions/send-email/index.ts
// Sends personalized digest emails with token-based unsubscribe (RFC 8058)
// Rate limited: max 10 emails per day per user
// A/B testing: supports subject line variants

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";
import { Resend } from "https://esm.sh/resend@1";
import { escapeHtml, checkRateLimit } from "./_shared/security.ts";

const resend = new Resend(Deno.env.get("RESEND_API_KEY")!);

interface EmailRequest {
  userId: string;
  emailType: string;
  subject: string;
  html: string;
  text?: string;
  variant?: string;
}

serve(async (req) => {
  const supabase = createClient(
    Deno.env.get("SUPABASE_URL")!,
    Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!,
  );

  const { userId, emailType, subject, html, text }: EmailRequest =
    await req.json();

  // Get user email and preferences
  const { data: user } = await supabase.auth.admin.getUserById(userId);

  if (!user?.user?.email) {
    return new Response(JSON.stringify({ error: "User not found" }), {
      status: 404,
    });
  }

  // Check preferences
  const { data: prefs } = await supabase
    .from("email_preferences")
    .select()
    .eq("user_id", userId)
    .single();

  if (!prefs?.emails_enabled) {
    return new Response(JSON.stringify({ error: "Emails disabled" }), {
      status: 400,
    });
  }

  // Rate limit check: max 10 emails per day
  const withinLimit = await checkRateLimit(supabase, userId, 10);
  if (!withinLimit) {
    return new Response(JSON.stringify({ error: "Rate limit exceeded" }), {
      status: 429,
    });
  }

  // Check specific email type preference
  const typeEnabled = {
    weekly_summary: prefs.weekly_summary,
    streak_celebration: prefs.streak_celebrations,
    achievement: prefs.achievement_notifications,
    lapsed_nudge: prefs.lapsed_nudges,
    monthly_report: prefs.monthly_report,
  }[emailType];

  if (typeEnabled === false) {
    return new Response(
      JSON.stringify({ error: "Email type disabled by user" }),
      { status: 400 },
    );
  }

  // SECURITY: Use unsubscribe token (RFC 8058 compliant) instead of plain userId
  const unsubscribeUrl = `https://getmindfriend.app/unsubscribe?token=${prefs.unsubscribe_token}`;

  // Send email
  try {
    const { data: emailResult } = await resend.emails.send({
      from: "MindFriend <hello@getmindfriend.app>",
      to: user.user.email,
      subject: escapeHtml(subject),
      html,
      text,
      headers: {
        // RFC 8058: One-click unsubscribe
        "List-Unsubscribe": `<${unsubscribeUrl}>`,
        "List-Unsubscribe-Post": "List-Unsubscribe=One-Click",
      },
    });

    // Log the email
    await supabase.from("email_logs").insert({
      user_id: userId,
      email_type: emailType,
      subject,
      message_id: emailResult?.id,
      status: "sent",
    });

    return new Response(
      JSON.stringify({ success: true, messageId: emailResult?.id }),
      {
        headers: { "Content-Type": "application/json" },
      },
    );
  } catch (error) {
    // Log failure
    await supabase.from("email_logs").insert({
      user_id: userId,
      email_type: emailType,
      subject,
      status: "failed",
      error_message: error.message,
    });

    throw error;
  }
});
```

### 8.2 process-email-queue (CRITICAL)

```typescript
// supabase/functions/process-email-queue/index.ts
// Processes pending emails from queue in batches (every 15 minutes via cron)

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

serve(async (req) => {
  const supabase = createClient(
    Deno.env.get("SUPABASE_URL")!,
    Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!,
  );

  // Get pending emails where scheduled_for <= now(), batch of 100
  const now = new Date().toISOString();
  const { data: queue } = await supabase
    .from("email_queue")
    .select("*")
    .eq("status", "pending")
    .lte("scheduled_for", now)
    .limit(100);

  if (!queue || queue.length === 0) {
    return new Response(JSON.stringify({ processed: 0 }), {
      headers: { "Content-Type": "application/json" },
    });
  }

  let successCount = 0;

  for (const email of queue) {
    // Mark as processing
    await supabase
      .from("email_queue")
      .update({ status: "processing" })
      .eq("id", email.id);

    try {
      // Send via send-email function
      await supabase.functions.invoke("send-email", {
        body: {
          userId: email.user_id,
          emailType: email.email_type,
          subject: email.payload.subject,
          html: email.payload.html,
          text: email.payload.text,
        },
      });

      // Mark as sent
      await supabase
        .from("email_queue")
        .update({ status: "sent", processed_at: new Date().toISOString() })
        .eq("id", email.id);

      successCount++;
    } catch (error) {
      // Mark as failed, will be retried
      await supabase
        .from("email_queue")
        .update({
          status: "failed",
          error_message: error.message,
          retry_count: (email.retry_count || 0) + 1,
          next_retry_at: calculateNextRetry(email.retry_count || 0),
        })
        .eq("id", email.id);
    }
  }

  return new Response(
    JSON.stringify({ processed: queue.length, succeeded: successCount }),
    {
      headers: { "Content-Type": "application/json" },
    },
  );
});

function calculateNextRetry(retryCount: number): string {
  const delays = [15 * 60, 60 * 60, 4 * 60 * 60]; // 15m, 1h, 4h in seconds
  const delaySeconds = delays[Math.min(retryCount, delays.length - 1)];
  const nextRetry = new Date(Date.now() + delaySeconds * 1000);
  return nextRetry.toISOString();
}
```

### 8.3 email-webhook (CRITICAL)

```typescript
// supabase/functions/email-webhook/index.ts
// Handles Resend webhooks for bounces, complaints, deliveries

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";
import { Webhook } from "https://esm.sh/@svix/svix@1";

async function verifyWebhookSignature(
  req: Request,
  bodyText: string,
): Promise<boolean> {
  const webhookSecret = Deno.env.get("RESEND_WEBHOOK_SECRET");
  if (!webhookSecret) {
    console.error("RESEND_WEBHOOK_SECRET not configured");
    return false;
  }

  const svixId = req.headers.get("svix-id");
  const svixTimestamp = req.headers.get("svix-timestamp");
  const svixSignature = req.headers.get("svix-signature");

  if (!svixId || !svixTimestamp || !svixSignature) {
    console.error("Missing webhook signature headers");
    return false;
  }

  try {
    const wh = new Webhook(webhookSecret);
    wh.verify(bodyText, {
      "svix-id": svixId,
      "svix-timestamp": svixTimestamp,
      "svix-signature": svixSignature,
    });
    return true;
  } catch (err) {
    console.error("Webhook signature verification failed:", err);
    return false;
  }
}

serve(async (req) => {
  if (req.method !== "POST") {
    return new Response("Method not allowed", { status: 405 });
  }

  // Verify webhook signature FIRST
  const bodyText = await req.text();
  const isValid = await verifyWebhookSignature(req, bodyText);

  if (!isValid) {
    console.warn("Rejecting webhook with invalid signature");
    return new Response("Unauthorized - Invalid signature", { status: 401 });
  }

  const supabase = createClient(
    Deno.env.get("SUPABASE_URL")!,
    Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!,
  );

  const event = JSON.parse(bodyText);
  const messageId = event.email?.id || event.message_id;

  // Find the log entry
  const { data: log } = await supabase
    .from("email_logs")
    .select("user_id")
    .eq("message_id", messageId)
    .single();

  if (!log) {
    return new Response("Log not found", { status: 404 });
  }

  switch (event.type) {
    case "email.delivered":
      await supabase
        .from("email_logs")
        .update({ status: "delivered" })
        .eq("message_id", messageId);
      break;

    case "email.opened":
      await supabase
        .from("email_logs")
        .update({ status: "opened", opened_at: new Date().toISOString() })
        .eq("message_id", messageId);
      break;

    case "email.clicked":
      await supabase
        .from("email_logs")
        .update({
          status: "clicked",
          clicked_at: new Date().toISOString(),
          click_url: event.click?.url || null,
        })
        .eq("message_id", messageId);
      break;

    case "email.bounced":
      // Hard bounce → disable emails for user
      if (event.bounce?.type === "permanent") {
        await supabase
          .from("email_preferences")
          .update({ emails_enabled: false, unsubscribe_reason: "Hard bounce" })
          .eq("user_id", log.user_id);
      }

      await supabase
        .from("email_logs")
        .update({ status: "bounced" })
        .eq("message_id", messageId);
      break;

    case "email.complained":
      // Spam complaint → unsubscribe immediately
      await supabase
        .from("email_preferences")
        .update({ emails_enabled: false, unsubscribe_reason: "Spam complaint" })
        .eq("user_id", log.user_id);

      await supabase
        .from("email_logs")
        .update({ status: "bounced" })
        .eq("message_id", messageId);
      break;
  }

  return new Response(JSON.stringify({ processed: true }), {
    headers: { "Content-Type": "application/json" },
  });
});
```

### 8.4 retry-failed-emails (CRITICAL)

```typescript
// supabase/functions/retry-failed-emails/index.ts
// Retries failed emails with exponential backoff (runs hourly via cron)

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

serve(async (req) => {
  const supabase = createClient(
    Deno.env.get("SUPABASE_URL")!,
    Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!,
  );

  const now = new Date().toISOString();

  // Find emails due for retry
  const { data: failedEmails } = await supabase
    .from("email_queue")
    .select("*")
    .eq("status", "failed")
    .lte("next_retry_at", now)
    .lt("retry_count", "max_retries");

  if (!failedEmails || failedEmails.length === 0) {
    return new Response(JSON.stringify({ retried: 0, moved_to_dlq: 0 }), {
      headers: { "Content-Type": "application/json" },
    });
  }

  let retriedCount = 0;
  let dlqCount = 0;

  for (const email of failedEmails) {
    if (email.retry_count >= email.max_retries) {
      // Max retries exceeded → move to dead letter queue
      await supabase.from("email_dead_letter_queue").insert({
        original_queue_id: email.id,
        user_id: email.user_id,
        email_type: email.email_type,
        scheduled_for: email.scheduled_for,
        payload: email.payload,
        error_message: email.error_message,
        total_retries: email.retry_count,
        first_attempt_at: email.created_at,
        requires_manual_review: true,
      });

      dlqCount++;
    } else {
      // Reset status to pending for next queue processor
      await supabase
        .from("email_queue")
        .update({ status: "pending" })
        .eq("id", email.id);

      retriedCount++;
    }
  }

  return new Response(
    JSON.stringify({ retried: retriedCount, moved_to_dlq: dlqCount }),
    {
      headers: { "Content-Type": "application/json" },
    },
  );
});
```

### 8.5 send-monthly-report (CRITICAL)

// supabase/functions/send-monthly-report/index.ts
// Sends monthly wellness report with month-over-month comparison stats
// Triggered by: Cron job (1st day of month at 9am UTC)

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";
import { escapeHtml } from "./\_shared/security.ts";

serve(async (req) => {
const supabase = createClient(
Deno.env.get("SUPABASE_URL")!,
Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!,
);

// Get users who want monthly reports
const { data: users } = await supabase
.from("email_preferences")
.select("user_id")
.eq("emails_enabled", true)
.eq("monthly_report", true);

if (!users) return new Response("No users", { status: 200 });

const now = new Date();
const currentMonthStart = new Date(now.getFullYear(), now.getMonth(), 1);
const oneMonthAgo = new Date(now.getFullYear(), now.getMonth() - 1, 1);

for (const { user_id } of users) {
// Gather current month stats
const [
{ data: profile },
{ data: currentMonthMoods },
{ data: previousMonthMoods },
{ data: currentMonthQuests },
{ data: previousMonthQuests },
{ data: currentMonthExercises },
{ data: previousMonthExercises },
{ data: currentMonthBadges },
] = await Promise.all([
supabase.from("profiles").select().eq("id", user_id).single(),
supabase.from("moods").select().eq("user_id", user_id).gte("logged_at", currentMonthStart.toISOString()),
supabase.from("moods").select().eq("user_id", user_id).gte("logged_at", oneMonthAgo.toISOString()).lt("logged_at", currentMonthStart.toISOString()),
supabase.from("quests").select().eq("user_id", user_id).eq("status", "completed").gte("completed_at", currentMonthStart.toISOString()),
supabase.from("quests").select().eq("user_id", user_id).eq("status", "completed").gte("completed_at", oneMonthAgo.toISOString()).lt("completed_at", currentMonthStart.toISOString()),
supabase.from("exercise_sessions").select().eq("user_id", user_id).gte("completed_at", currentMonthStart.toISOString()),
supabase.from("exercise_sessions").select().eq("user_id", user_id).gte("completed_at", oneMonthAgo.toISOString()).lt("completed_at", currentMonthStart.toISOString()),
supabase.from("user_badges").select("*, badges(*)").eq("user_id", user_id).gte("earned_at", currentMonthStart.toISOString()),
]);

    const stats = {
      name: profile?.display_name || "Friend",
      currentStreak: profile?.current_streak || 0,
      monthName: currentMonthStart.toLocaleString("default", { month: "long" }),
      moodCheckins: currentMonthMoods?.length || 0,
      questsCompleted: currentMonthQuests?.length || 0,
      exerciseMinutes: Math.round(((currentMonthExercises?.reduce((sum, e) => sum + (e.duration_seconds || 0), 0) || 0) / 60)),
      badgesEarned: currentMonthBadges?.map((b) => ({ name: b.badges.name, icon: b.badges.icon })) || [],
      avgMood: currentMonthMoods?.length ? (currentMonthMoods.reduce((sum, m) => sum + m.score, 0) / currentMonthMoods.length).toFixed(1) : null,
      prevMoodCheckins: previousMonthMoods?.length || 0,
      prevQuestsCompleted: previousMonthQuests?.length || 0,
      prevExerciseMinutes: Math.round(((previousMonthExercises?.reduce((sum, e) => sum + (e.duration_seconds || 0), 0) || 0) / 60)),
    };

    // SKIP if user had zero activity this month
    if (stats.moodCheckins === 0 && stats.questsCompleted === 0 && stats.exerciseMinutes === 0) {
      continue;
    }

    // Calculate month-over-month changes
    const moodChange = stats.moodCheckins - stats.prevMoodCheckins;
    const questChange = stats.questsCompleted - stats.prevQuestsCompleted;
    const exerciseChange = stats.exerciseMinutes - stats.prevExerciseMinutes;

    const html = generateMonthlyReportHtml(stats, { moodChange, questChange, exerciseChange });
    const subject = `Your ${stats.monthName} wellness report, ${stats.name} 📊`;

    // ENQUEUE email send (not direct invoke)
    await supabase.from("email_queue").insert({
      user_id,
      email_type: "monthly_report",
      scheduled_for: now.toISOString(),
      payload: { subject, html },
    });

}

return new Response(JSON.stringify({ processed: users.length }), {
headers: { "Content-Type": "application/json" },
});
});

function generateMonthlyReportHtml(stats: any, changes: any): string {
const formatChange = (change: number) => {
if (change > 0) return `<span style="color: #10b981;">+${change} ↑</span>`;
if (change < 0) return `<span style="color: #ef4444;">${change} ↓</span>`;
return '<span style="color: #64748b;">—</span>';
};

return `

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Email Preferences - MindFriend</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: #f5f5f5;
        color: #1a1a2e;
      }
      @media (prefers-color-scheme: dark) {
        body {
          background: #0f0f1e;
          color: #f5f5f5;
        }
      }

      .container {
        max-width: 500px;
        margin: 40px auto;
        padding: 20px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }
      @media (prefers-color-scheme: dark) {
        .container {
          background: #1e293b;
          box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        }
      }

      .header {
        text-align: center;
        margin-bottom: 32px;
      }
      .header h1 {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 8px;
      }
      .header p {
        color: #64748b;
        font-size: 14px;
      }

      .form-group {
        margin-bottom: 20px;
      }
      .form-group label {
        display: flex;
        align-items: center;
        padding: 12px;
        border-radius: 8px;
        background: #f8fafc;
        cursor: pointer;
      }
      @media (prefers-color-scheme: dark) {
        .form-group label {
          background: #334155;
        }
      }
      .form-group label:hover {
        background: #e2e8f0;
      }
      @media (prefers-color-scheme: dark) {
        .form-group label:hover {
          background: #475569;
        }
      }

      .form-group input[type="checkbox"] {
        width: 18px;
        height: 18px;
        margin-right: 12px;
        cursor: pointer;
      }
      .form-group .label-text {
        flex: 1;
      }
      .form-group .label-text strong {
        display: block;
        margin-bottom: 2px;
      }
      .form-group .label-text small {
        color: #64748b;
        font-size: 12px;
      }

      .button-group {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 32px;
      }
      button {
        padding: 12px 24px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn-save {
        background: #6366f1;
        color: white;
      }
      .btn-save:hover {
        background: #4f46e5;
      }
      .btn-cancel {
        background: #e2e8f0;
        color: #1a1a2e;
      }
      .btn-cancel:hover {
        background: #cbd5e1;
      }
      @media (prefers-color-scheme: dark) {
        .btn-cancel {
          background: #334155;
          color: #f5f5f5;
        }
        .btn-cancel:hover {
          background: #475569;
        }
      }

      .unsubscribe-all {
        margin-top: 24px;
        padding-top: 24px;
        border-top: 1px solid #e2e8f0;
      }
      @media (prefers-color-scheme: dark) {
        .unsubscribe-all {
          border-top-color: #334155;
        }
      }
      .unsubscribe-all button {
        width: 100%;
        background: #ef4444;
        color: white;
      }
      .unsubscribe-all button:hover {
        background: #dc2626;
      }

      .success-message,
      .error-message {
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        display: none;
      }
      .success-message {
        background: #d1fae5;
        color: #065f46;
      }
      .success-message.show {
        display: block;
      }
      .error-message {
        background: #fee2e2;
        color: #991b1b;
      }
      .error-message.show {
        display: block;
      }

      .loading {
        opacity: 0.6;
        pointer-events: none;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Email Preferences</h1>
        <p>Choose which emails you'd like to receive</p>
      </div>

      <div class="success-message" id="successMsg">
        ✅ Preferences saved successfully
      </div>
      <div class="error-message" id="errorMsg">❌ Error saving preferences</div>

      <form id="preferencesForm">
        <div class="form-group">
          <label>
            <input type="checkbox" name="weekly_summary" checked />
            <div class="label-text">
              <strong>Weekly Summary</strong>
              <small>Get your weekly wellness digest every Sunday</small>
            </div>
          </label>
        </div>

        <div class="form-group">
          <label>
            <input type="checkbox" name="streak_celebrations" checked />
            <div class="label-text">
              <strong>Streak Celebrations</strong>
              <small>Celebrate your milestones (7, 14, 30+ days)</small>
            </div>
          </label>
        </div>

        <div class="form-group">
          <label>
            <input type="checkbox" name="achievement_notifications" checked />
            <div class="label-text">
              <strong>Achievement Notifications</strong>
              <small>Get notified when you earn new badges</small>
            </div>
          </label>
        </div>

        <div class="form-group">
          <label>
            <input type="checkbox" name="lapsed_nudges" checked />
            <div class="label-text">
              <strong>Re-engagement Nudges</strong>
              <small>Gentle reminders if you've been away</small>
            </div>
          </label>
        </div>

        <div class="form-group">
          <label>
            <input type="checkbox" name="monthly_report" checked />
            <div class="label-text">
              <strong>Monthly Report</strong>
              <small>In-depth monthly wellness report on the 1st</small>
            </div>
          </label>
        </div>

        <div class="button-group">
          <button type="submit" class="btn-save">Save Changes</button>
          <button
            type="button"
            class="btn-cancel"
            onclick="window.history.back()"
          >
            Cancel
          </button>
        </div>

        <div class="unsubscribe-all">
          <button type="button" onclick="unsubscribeAll()">
            Unsubscribe from All Emails
          </button>
        </div>
      </form>
    </div>

    <script>
      const token = new URLSearchParams(window.location.search).get("token");
      if (!token) {
        document.getElementById("errorMsg").textContent =
          "❌ Invalid unsubscribe link";
        document.getElementById("errorMsg").classList.add("show");
      }

      async function loadPreferences() {
        try {
          const response = await fetch(`/api/email-preferences?token=${token}`);
          if (!response.ok) throw new Error("Failed to load preferences");

          const prefs = await response.json();
          document.querySelector('[name="weekly_summary"]').checked =
            prefs.weekly_summary;
          document.querySelector('[name="streak_celebrations"]').checked =
            prefs.streak_celebrations;
          document.querySelector('[name="achievement_notifications"]').checked =
            prefs.achievement_notifications;
          document.querySelector('[name="lapsed_nudges"]').checked =
            prefs.lapsed_nudges;
          document.querySelector('[name="monthly_report"]').checked =
            prefs.monthly_report;
        } catch (err) {
          console.error("Failed to load preferences:", err);
        }
      }

      document
        .getElementById("preferencesForm")
        .addEventListener("submit", async (e) => {
          e.preventDefault();
          const form = e.target;
          form.classList.add("loading");

          try {
            const response = await fetch(`/api/email-preferences`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                token,
                weekly_summary: form.weekly_summary.checked,
                streak_celebrations: form.streak_celebrations.checked,
                achievement_notifications:
                  form.achievement_notifications.checked,
                lapsed_nudges: form.lapsed_nudges.checked,
                monthly_report: form.monthly_report.checked,
              }),
            });

            if (!response.ok) throw new Error("Failed to save preferences");

            document.getElementById("successMsg").classList.add("show");
            setTimeout(
              () =>
                document.getElementById("successMsg").classList.remove("show"),
              3000,
            );
          } catch (err) {
            console.error("Failed to save:", err);
            document.getElementById("errorMsg").classList.add("show");
            setTimeout(
              () =>
                document.getElementById("errorMsg").classList.remove("show"),
              3000,
            );
          } finally {
            form.classList.remove("loading");
          }
        });

      async function unsubscribeAll() {
        if (
          !confirm(
            "Are you sure you want to unsubscribe from all emails? You can re-enable them anytime.",
          )
        ) {
          return;
        }

        try {
          const response = await fetch(`/api/email-preferences/unsubscribe`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ token }),
          });

          if (!response.ok) throw new Error("Failed to unsubscribe");

          document.getElementById("successMsg").textContent =
            "✅ Unsubscribed from all emails";
          document.getElementById("successMsg").classList.add("show");
          setTimeout(() => (window.location.href = "/"), 2000);
        } catch (err) {
          console.error("Failed to unsubscribe:", err);
          document.getElementById("errorMsg").textContent =
            "❌ Error unsubscribing";
          document.getElementById("errorMsg").classList.add("show");
        }
      }

      loadPreferences();
    </script>
  </body>
</html>
`;

  return { subject, html };
}
```

