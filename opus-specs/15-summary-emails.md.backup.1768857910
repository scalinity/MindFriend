        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }
      @media (prefers-color-scheme: dark) {
        .container {
          background: #1e293b;
          box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        }
      }

      .header {
        text-align: center;
        margin-bottom: 32px;
      }
      .header h1 {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 8px;
      }
      .header p {
        color: #64748b;
        font-size: 14px;
      }

      .form-group {
        margin-bottom: 20px;
      }
      .form-group label {
        display: flex;
        align-items: center;
        padding: 12px;
        border-radius: 8px;
        background: #f8fafc;
        cursor: pointer;
      }
      @media (prefers-color-scheme: dark) {
        .form-group label {
          background: #334155;
        }
      }
      .form-group label:hover {
        background: #e2e8f0;
      }
      @media (prefers-color-scheme: dark) {
        .form-group label:hover {
          background: #475569;
        }
      }

      .form-group input[type="checkbox"] {
        width: 18px;
        height: 18px;
        margin-right: 12px;
        cursor: pointer;
      }
      .form-group .label-text {
        flex: 1;
      }
      .form-group .label-text strong {
        display: block;
        margin-bottom: 2px;
      }
      .form-group .label-text small {
        color: #64748b;
        font-size: 12px;
      }

      .button-group {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 32px;
      }
      button {
        padding: 12px 24px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn-save {
        background: #6366f1;
        color: white;
      }
      .btn-save:hover {
        background: #4f46e5;
      }
      .btn-cancel {
        background: #e2e8f0;
        color: #1a1a2e;
      }
      .btn-cancel:hover {
        background: #cbd5e1;
      }
      @media (prefers-color-scheme: dark) {
        .btn-cancel {
          background: #334155;
          color: #f5f5f5;
        }
        .btn-cancel:hover {
          background: #475569;
        }
      }

      .unsubscribe-all {
        margin-top: 24px;
        padding-top: 24px;
        border-top: 1px solid #e2e8f0;
      }
      @media (prefers-color-scheme: dark) {
        .unsubscribe-all {
          border-top-color: #334155;
        }
      }
      .unsubscribe-all button {
        width: 100%;
        background: #ef4444;
        color: white;
      }
      .unsubscribe-all button:hover {
        background: #dc2626;
      }

      .success-message,
      .error-message {
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        display: none;
      }
      .success-message {
