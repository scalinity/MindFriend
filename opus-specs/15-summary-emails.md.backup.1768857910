        }
      }

      .unsubscribe-all {
        margin-top: 24px;
        padding-top: 24px;
        border-top: 1px solid #e2e8f0;
      }
      @media (prefers-color-scheme: dark) {
        .unsubscribe-all {
          border-top-color: #334155;
        }
      }
      .unsubscribe-all button {
        width: 100%;
        background: #ef4444;
        color: white;
      }
      .unsubscribe-all button:hover {
        background: #dc2626;
      }

      .success-message,
      .error-message {
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        display: none;
      }
      .success-message {
        background: #d1fae5;
        color: #065f46;
      }
      .success-message.show {
        display: block;
      }
      .error-message {
        background: #fee2e2;
        color: #991b1b;
      }
      .error-message.show {
        display: block;
      }

      .loading {
        opacity: 0.6;
        pointer-events: none;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Email Preferences</h1>
        <p>Choose which emails you'd like to receive</p>
      </div>

      <div class="success-message" id="successMsg">
        ✅ Preferences saved successfully
      </div>
      <div class="error-message" id="errorMsg">❌ Error saving preferences</div>

      <form id="preferencesForm">
        <div class="form-group">
          <label>
            <input type="checkbox" name="weekly_summary" checked />
            <div class="label-text">
              <strong>Weekly Summary</strong>
              <small>Get your weekly wellness digest every Sunday</small>
            </div>
          </label>
        </div>

        <div class="form-group">
          <label>
            <input type="checkbox" name="streak_celebrations" checked />
            <div class="label-text">
              <strong>Streak Celebrations</strong>
              <small>Celebrate your milestones (7, 14, 30+ days)</small>
            </div>
          </label>
        </div>

        <div class="form-group">
          <label>
            <input type="checkbox" name="achievement_notifications" checked />
            <div class="label-text">
              <strong>Achievement Notifications</strong>
              <small>Get notified when you earn new badges</small>
            </div>
          </label>
        </div>

        <div class="form-group">
          <label>
            <input type="checkbox" name="lapsed_nudges" checked />
            <div class="label-text">
              <strong>Re-engagement Nudges</strong>
              <small>Gentle reminders if you've been away</small>
            </div>
          </label>
        </div>

        <div class="form-group">
          <label>
            <input type="checkbox" name="monthly_report" checked />
            <div class="label-text">
              <strong>Monthly Report</strong>
              <small>In-depth monthly wellness report on the 1st</small>
            </div>
          </label>
        </div>

        <div class="button-group">
          <button type="submit" class="btn-save">Save Changes</button>
          <button
            type="button"
            class="btn-cancel"
            onclick="window.history.back()"
          >
            Cancel
          </button>
        </div>

        <div class="unsubscribe-all">
          <button type="button" onclick="unsubscribeAll()">
            Unsubscribe from All Emails
          </button>
        </div>
      </form>
    </div>

    <script>
      const token = new URLSearchParams(window.location.search).get("token");
      if (!token) {
        document.getElementById("errorMsg").textContent =
          "❌ Invalid unsubscribe link";
        document.getElementById("errorMsg").classList.add("show");
      }

      async function loadPreferences() {
        try {
          const response = await fetch(`/api/email-preferences?token=${token}`);
          if (!response.ok) throw new Error("Failed to load preferences");

          const prefs = await response.json();
          document.querySelector('[name="weekly_summary"]').checked =
            prefs.weekly_summary;
          document.querySelector('[name="streak_celebrations"]').checked =
            prefs.streak_celebrations;
          document.querySelector('[name="achievement_notifications"]').checked =
            prefs.achievement_notifications;
          document.querySelector('[name="lapsed_nudges"]').checked =
            prefs.lapsed_nudges;
          document.querySelector('[name="monthly_report"]').checked =
            prefs.monthly_report;
        } catch (err) {
          console.error("Failed to load preferences:", err);
        }
      }

      document
        .getElementById("preferencesForm")
        .addEventListener("submit", async (e) => {
          e.preventDefault();
          const form = e.target;
          form.classList.add("loading");

          try {
            const response = await fetch(`/api/email-preferences`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                token,
                weekly_summary: form.weekly_summary.checked,
                streak_celebrations: form.streak_celebrations.checked,
                achievement_notifications:
                  form.achievement_notifications.checked,
                lapsed_nudges: form.lapsed_nudges.checked,
                monthly_report: form.monthly_report.checked,
              }),
            });

            if (!response.ok) throw new Error("Failed to save preferences");

            document.getElementById("successMsg").classList.add("show");
            setTimeout(
              () =>
                document.getElementById("successMsg").classList.remove("show"),
              3000,
            );
          } catch (err) {
            console.error("Failed to save:", err);
            document.getElementById("errorMsg").classList.add("show");
            setTimeout(
              () =>
                document.getElementById("errorMsg").classList.remove("show"),
              3000,
            );
          } finally {
            form.classList.remove("loading");
          }
        });

      async function unsubscribeAll() {
        if (
          !confirm(
            "Are you sure you want to unsubscribe from all emails? You can re-enable them anytime.",
          )
        ) {
          return;
        }

        try {
          const response = await fetch(`/api/email-preferences/unsubscribe`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ token }),
          });

          if (!response.ok) throw new Error("Failed to unsubscribe");

          document.getElementById("successMsg").textContent =
            "✅ Unsubscribed from all emails";
          document.getElementById("successMsg").classList.add("show");
          setTimeout(() => (window.location.href = "/"), 2000);
        } catch (err) {
          console.error("Failed to unsubscribe:", err);
          document.getElementById("errorMsg").textContent =
            "❌ Error unsubscribing";
          document.getElementById("errorMsg").classList.add("show");
        }
      }

      loadPreferences();
    </script>
  </body>
</html>
`;

  return { subject, html };
}
```

