        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn-save {
        background: #6366f1;
        color: white;
      }
      .btn-save:hover {
        background: #4f46e5;
      }
      .btn-cancel {
        background: #e2e8f0;
        color: #1a1a2e;
      }
      .btn-cancel:hover {
        background: #cbd5e1;
      }
      @media (prefers-color-scheme: dark) {
