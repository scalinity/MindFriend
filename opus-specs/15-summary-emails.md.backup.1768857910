// Core/Models/EmailModels.swift

struct EmailPreferences: Codable {
    let id: UUID
    let userId: UUID

    // Global controls
    var emailsEnabled: Bool = true

    // Individual email types
    var weeklySummary: Bool = true
    var streakCelebrations: Bool = true
    var achievementNotifications: Bool = true
    var lapsedNudges: Bool = true
    var monthlyReport: Bool = true

    // Settings
    var preferredSendHour: Int = 9  // 0-23
    var userTimezone: String = "UTC"
    var unsubscribeToken: UUID

    enum CodingKeys: String, CodingKey {
        case id, userId
        case emailsEnabled = "emails_enabled"
        case weeklySummary = "weekly_summary"
        case streakCelebrations = "streak_celebrations"
        case achievementNotifications = "achievement_notifications"
        case lapsedNudges = "lapsed_nudges"
        case monthlyReport = "monthly_report"
        case preferredSendHour = "preferred_send_hour"
        case userTimezone = "user_timezone"
        case unsubscribeToken = "unsubscribe_token"
    }
}
```

### 5.2 EmailPreferencesViewModel

```swift
// Features/Profile/EmailPreferencesViewModel.swift

import Foundation
import Combine

@MainActor
final class EmailPreferencesViewModel: ObservableObject {
    @Published var preferences: EmailPreferences?
    @Published var isLoading = false
    @Published var isSaving = false
    @Published var errorMessage: String?
    @Published var successMessage: String?

    private let supabaseDataService: SupabaseDataService
    private var cancellables = Set<AnyCancellable>()

    init(supabaseDataService: SupabaseDataService) {
        self.supabaseDataService = supabaseDataService
    }

    func loadPreferences() async {
        isLoading = true
        errorMessage = nil

        do {
            // Fetch user's email preferences
            let prefs: EmailPreferences = try await supabaseDataService.fetch(
                from: "email_preferences",
                where: ["user_id": supabaseDataService.currentUserId]
            )
            self.preferences = prefs
        } catch {
            errorMessage = "Failed to load preferences: \(error.localizedDescription)"
        }

        isLoading = false
    }

    func savePreferences() async {
        guard let prefs = preferences else { return }

        isSaving = true
        errorMessage = nil

        do {
            try await supabaseDataService.update(
                table: "email_preferences",
                where: ["user_id": supabaseDataService.currentUserId],
                data: prefs
            )
            successMessage = "Preferences saved!"

            // Clear success message after 2 seconds
            try await Task.sleep(nanoseconds: 2_000_000_000)
            successMessage = nil
        } catch {
            errorMessage = "Failed to save preferences: \(error.localizedDescription)"
        }

        isSaving = false
    }
}
```

### 5.3 EmailPreferencesView (SwiftUI)

```swift
// Features/Profile/EmailPreferencesView.swift

import SwiftUI

struct EmailPreferencesView: View {
    @StateObject private var viewModel: EmailPreferencesViewModel
    @Environment(\.dismiss) var dismiss

    private let timezones = TimeZone.knownTimeZoneIdentifiers
    private let hours = Array(0..<24)

    init(supabaseDataService: SupabaseDataService) {
        _viewModel = StateObject(wrappedValue: EmailPreferencesViewModel(
            supabaseDataService: supabaseDataService
        ))
    }

    var body: some View {
        NavigationStack {
            ZStack {
                if viewModel.isLoading {
                    ProgressView()
                } else if let prefs = viewModel.preferences {
                    Form {
                        // Global enable/disable
                        Section(header: Text("All Emails")) {
                            Toggle("Enable all emails", isOn: Binding(
                                get: { prefs.emailsEnabled },
                                set: { viewModel.preferences?.emailsEnabled = $0 }
                            ))
                            .accessibilityLabel("Toggle all emails")
                        }

                        // Individual email types
                        Section(header: Text("Email Types")) {
                            Toggle("Weekly Summary", isOn: Binding(
                                get: { prefs.weeklySummary },
                                set: { viewModel.preferences?.weeklySummary = $0 }
                            ))
                            .accessibilityLabel("Toggle weekly summary emails")

                            Toggle("Streak Celebrations", isOn: Binding(
                                get: { prefs.streakCelebrations },
                                set: { viewModel.preferences?.streakCelebrations = $0 }
                            ))
                            .accessibilityLabel("Toggle streak celebration emails")

                            Toggle("Achievement Notifications", isOn: Binding(
                                get: { prefs.achievementNotifications },
                                set: { viewModel.preferences?.achievementNotifications = $0 }
                            ))
                            .accessibilityLabel("Toggle achievement notification emails")

                            Toggle("Lapsed User Nudges", isOn: Binding(
                                get: { prefs.lapsedNudges },
                                set: { viewModel.preferences?.lapsedNudges = $0 }
                            ))
                            .accessibilityLabel("Toggle lapsed user nudge emails")

                            Toggle("Monthly Report", isOn: Binding(
                                get: { prefs.monthlyReport },
                                set: { viewModel.preferences?.monthlyReport = $0 }
                            ))
                            .accessibilityLabel("Toggle monthly report emails")
                        }

                        // Timing preferences
                        Section(header: Text("Timing")) {
                            Picker("Preferred Send Time", selection: Binding(
                                get: { prefs.preferredSendHour },
                                set: { viewModel.preferences?.preferredSendHour = $0 }
                            )) {
                                ForEach(hours, id: \.self) { hour in
                                    Text(formatHour(hour)).tag(hour)
                                }
                            }
                            .accessibilityLabel("Select preferred email send time")

                            Picker("Timezone", selection: Binding(
                                get: { prefs.userTimezone },
                                set: { viewModel.preferences?.userTimezone = $0 }
                            )) {
                                ForEach(timezones, id: \.self) { tz in
                                    Text(tz).tag(tz)
                                }
                            }
                            .searchable(text: .constant(""), prompt: "Search timezone")
                            .accessibilityLabel("Select your timezone")
                        }

                        // Status messages
                        if let error = viewModel.errorMessage {
                            Section {
                                HStack {
                                    Image(systemName: "exclamationmark.circle.fill")
                                        .foregroundColor(.red)
                                    Text(error)
                                        .font(.caption)
                                }
                            }
                        }

                        if let success = viewModel.successMessage {
                            Section {
                                HStack {
                                    Image(systemName: "checkmark.circle.fill")
                                        .foregroundColor(.green)
                                    Text(success)
                                        .font(.caption)
                                }
                            }
                        }
                    }
                    .disabled(viewModel.isSaving)
                    .opacity(viewModel.isSaving ? 0.6 : 1.0)
                } else {
                    Text("Failed to load preferences")
                }
            }
            .navigationTitle("Email Preferences")
            .navigationBarTitleDisplayMode(.inline)
            .toolbar {
                ToolbarItem(placement: .navigationBarLeading) {
                    Button("Cancel") {
                        dismiss()
                    }
                }
                ToolbarItem(placement: .navigationBarTrailing) {
                    Button("Save") {
                        Task {
                            await viewModel.savePreferences()
                            if viewModel.errorMessage == nil {
                                dismiss()
                            }
                        }
                    }
                    .disabled(viewModel.isSaving)
                }
            }
            .task {
                await viewModel.loadPreferences()
            }
        }
    }

    private func formatHour(_ hour: Int) -> String {
        let formatter = DateFormatter()
        formatter.dateFormat = "h a"
        let date = Calendar.current.date(bySettingHour: hour, minute: 0, second: 0, of: Date()) ?? Date()
        return formatter.string(from: date)
    }
}

