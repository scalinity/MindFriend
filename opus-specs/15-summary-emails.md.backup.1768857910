        }
      }
      .unsubscribe-all button {
        width: 100%;
        background: #ef4444;
        color: white;
      }
      .unsubscribe-all button:hover {
        background: #dc2626;
      }

      .success-message,
      .error-message {
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        display: none;
      }
      .success-message {
