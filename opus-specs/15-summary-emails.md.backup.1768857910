        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }
      @media (prefers-color-scheme: dark) {
        .container {
          background: #1e293b;
          box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        }
      }

      .header {
        text-align: center;
        margin-bottom: 32px;
      }
      .header h1 {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 8px;
      }
      .header p {
        color: #64748b;
        font-size: 14px;
      }

      .form-group {
        margin-bottom: 20px;
      }
      .form-group label {
        display: flex;
        align-items: center;
        padding: 12px;
        border-radius: 8px;
        background: #f8fafc;
        cursor: pointer;
      }
      @media (prefers-color-scheme: dark) {
        .form-group label {
          background: #334155;
        }
      }
      .form-group label:hover {
        background: #e2e8f0;
      }
      @media (prefers-color-scheme: dark) {
        .form-group label:hover {
          background: #475569;
        }
      }

      .form-group input[type="checkbox"] {
        width: 18px;
        height: 18px;
        margin-right: 12px;
        cursor: pointer;
      }
      .form-group .label-text {
        flex: 1;
      }
      .form-group .label-text strong {
        display: block;
        margin-bottom: 2px;
      }
      .form-group .label-text small {
        color: #64748b;
        font-size: 12px;
      }

      .button-group {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 32px;
      }
      button {
        padding: 12px 24px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
      }
