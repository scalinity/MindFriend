// MindFriend Pause Quest Arc Edge Function
// Pauses user's active quest arc
// See: docs/specs/quest-arcs-formal-spec.md

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";
import { getCorsHeaders } from "../_shared/cors.ts";
import { authenticateRequest, safeParseJson } from "../_shared/request-validation.ts";
import { validateUuid } from "../_shared/uuid-validation.ts";

serve(async (req) => {
  const origin = req.headers.get("Origin");
  const headers = {
    ...getCorsHeaders(origin),
    "Content-Type": "application/json",
  };

  if (req.method === "OPTIONS") {
    return new Response("ok", { headers: getCorsHeaders(origin) });
  }

  try {
    const supabase = createClient(
      Deno.env.get("SUPABASE_URL")!,
      Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!,
    );

    const authHeader = req.headers.get("Authorization");
    if (!authHeader) {
      return new Response(JSON.stringify({ error: "Missing authorization header" }), {
        status: 401,
        headers,
      });
    }

    const token = authHeader.replace("Bearer ", "");
    const {
      data: { user },
      error: authError,
    } = await supabase.auth.getUser(token);

    if (authError || !user) {
      return new Response(JSON.stringify({ error: "Unauthorized" }), {
        status: 401,
        headers,
      });
    }

    // Parse request body (userArcId is optional)
    const body = await safeParseJson<{ userArcId?: string }>(req);
    const userArcId = body?.userArcId;

    // Validate userArcId if provided
    if (userArcId) {
      const validation = validateUuid(userArcId, "userArcId");
      if (!validation.valid) {
        return new Response(JSON.stringify({ error: validation.error }), {
          status: 400,
          headers,
        });
      }
    }

    // Find active arc (use userArcId if provided, otherwise find active arc)
    let query = supabase
      .from("user_quest_arcs")
      .select("id, current_day, status, paused_at")
      .eq("user_id", user.id);

    if (userArcId) {
      const validation = validateUuid(userArcId, "userArcId");
      if (validation.valid) {
        query = query.eq("id", validation.normalized!);
      }
    } else {
      query = query.eq("status", "active");
    }

    const { data: arc, error: arcError } = await query.single();

    if (arcError || !arc) {
      return new Response(JSON.stringify({ error: "No active arc found" }), {
        status: 404,
        headers,
      });
    }

    // Idempotent: if already paused, return success
    if (arc.status === "paused") {
      const expiresAt = new Date(arc.paused_at);
      expiresAt.setDate(expiresAt.getDate() + 30);

      return new Response(
        JSON.stringify({
          success: true,
          pausedAt: arc.paused_at,
          currentDay: arc.current_day,
          expiresAt: expiresAt.toISOString(),
        }),
        { status: 200, headers },
      );
    }

    // Pause the arc
    const pausedAt = new Date().toISOString();
    const { error: updateError } = await supabase
      .from("user_quest_arcs")
      .update({
        status: "paused",
        paused_at: pausedAt,
      })
      .eq("id", arc.id);

    if (updateError) {
      console.error("Error pausing arc:", updateError);
      return new Response(JSON.stringify({ error: "Failed to pause arc" }), {
        status: 500,
        headers,
      });
    }

    const expiresAt = new Date();
    expiresAt.setDate(expiresAt.getDate() + 30);

    return new Response(
      JSON.stringify({
        success: true,
        pausedAt,
        currentDay: arc.current_day,
        expiresAt: expiresAt.toISOString(),
      }),
      { status: 200, headers },
    );
  } catch (error) {
    console.error("pause-quest-arc error:", error);
    return new Response(JSON.stringify({ error: "Internal server error" }), {
      status: 500,
      headers,
    });
  }
});
