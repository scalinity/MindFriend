{
  "compilerOptions": {
    "lib": ["deno.ns", "deno.unstable", "dom", "dom.iterable", "esnext"],
    "strict": true,
    "noImplicitAny": true
  },
  "imports": {
    "@supabase/supabase-js": "https://esm.sh/@supabase/supabase-js@2.118.0"
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any", "no-import-prefix"]
    }
  },
  "fmt": {
    "indentWidth": 2,
    "singleQuote": false
  }
}
