import re

# Read the project file
with open('MindFriendApp.xcodeproj/project.pbxproj', 'r') as f:
    content = f.read()

# Files to remove
files_to_remove = [
    'UserService.swift',
    'SessionManager.swift', 
    'QuestService.swift',
    'MoodService.swift',
    'KeychainManager.swift',
    'ExerciseService.swift',
    'CircleService.swift',
    'CertificatePinning.swift',
    'AuthService.swift',
    'APIEndpoint.swift',
    'APIClient.swift'
]

for filename in files_to_remove:
    # Remove PBXBuildFile entries (lines containing "filename in Sources")
    pattern = rf'^\s*[A-F0-9]+ /\* {re.escape(filename)} in Sources \*/ = \{{.*?\}};\s*\n'
    content = re.sub(pattern, '', content, flags=re.MULTILINE)
    
    # Remove PBXFileReference entries
    pattern = rf'^\s*[A-F0-9]+ /\* {re.escape(filename)} \*/ = \{{isa = PBXFileReference.*?\}};\s*\n'
    content = re.sub(pattern, '', content, flags=re.MULTILINE)
    
    # Remove from group children lists
    pattern = rf'^\s*[A-F0-9]+ /\* {re.escape(filename)} \*/,\s*\n'
    content = re.sub(pattern, '', content, flags=re.MULTILINE)
    
    # Remove from build phase file lists
    pattern = rf'^\s*[A-F0-9]+ /\* {re.escape(filename)} in Sources \*/,\s*\n'
    content = re.sub(pattern, '', content, flags=re.MULTILINE)

# Write back
with open('MindFriendApp.xcodeproj/project.pbxproj', 'w') as f:
    f.write(content)

print(f"Removed {len(files_to_remove)} stale file references")
EOF
