    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#6366f1',
            'primary-dark': '#4f46e5',
          },
        },
      },
    }
  </script>

  <!-- Supabase JS -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    .spinner {
      width: 40px;
      height: 40px;
      border: 3px solid rgba(99, 102, 241, 0.2);
      border-top-color: #6366f1;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center px-6">

  <div class="text-center">
    <div class="spinner mx-auto mb-6" id="spinner"></div>
    <p class="text-gray-600" id="status">Verifying your request...</p>
  </div>

  <script>
    const SUPABASE_URL = 'https://zfaucivtzfwnrijsbfug.supabase.co';
    const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpmYXVjaXZ0emZ3bnJpanNiZnVnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjgyNTI2NDgsImV4cCI6MjA4MzgyODY0OH0.tZaiIYvZKLUZFoNl2nvfRbOj8lodtY7Kw7BiQyoK2Rk';

    const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    const statusEl = document.getElementById('status');
    const spinnerEl = document.getElementById('spinner');

    function showError(message) {
      spinnerEl.style.display = 'none';
      statusEl.textContent = message;
      statusEl.classList.add('text-red-600');
      setTimeout(() => { window.location.href = '/'; }, 4000);
    }

    function showSuccess(message) {
      spinnerEl.style.display = 'none';
      statusEl.textContent = message;
      statusEl.classList.add('text-green-600');
    }

    async function handleAuthCallback() {
      try {
        // Log URL for debugging
        console.log('Full URL:', window.location.href);
        console.log('Hash:', window.location.hash);
        console.log('Search:', window.location.search);

        // Parse both hash and query params
        const hashParams = new URLSearchParams(window.location.hash.substring(1));
        const queryParams = new URLSearchParams(window.location.search);

        // Check for errors
        const error = hashParams.get('error') || queryParams.get('error');
        const errorDescription = hashParams.get('error_description') || queryParams.get('error_description');
        if (error) {
          throw new Error(errorDescription || error);
        }

        // Get auth type
        const type = hashParams.get('type') || queryParams.get('type');
        console.log('Auth type:', type);

        // Handle password recovery
        if (type === 'recovery') {
          const accessToken = hashParams.get('access_token');
          const refreshToken = hashParams.get('refresh_token');
          if (accessToken) {
            sessionStorage.setItem('recovery_access_token', accessToken);
            if (refreshToken) sessionStorage.setItem('recovery_refresh_token', refreshToken);
          }
          window.location.href = '/auth/reset-password';
          return;
        }

        // Handle email confirmation (signup, email_change, magiclink)
        // Supabase v2 uses token_hash in query params
        const tokenHash = queryParams.get('token_hash');
        const accessToken = hashParams.get('access_token');

        if (tokenHash) {
          // New Supabase flow - verify OTP with token_hash
          console.log('Using token_hash flow');
          statusEl.textContent = 'Confirming your email...';
          
          const { data, error: verifyError } = await supabase.auth.verifyOtp({
            token_hash: tokenHash,
            type: type || 'signup'
          });

          if (verifyError) {
            console.error('Verify OTP error:', verifyError);
            throw verifyError;
          }

          console.log('OTP verified successfully');
          window.location.href = '/auth/confirmed';
          return;
        }

        if (accessToken) {
          // Old flow - set session from access token
          console.log('Using access_token flow');
          const refreshToken = hashParams.get('refresh_token');
          
          const { error: sessionError } = await supabase.auth.setSession({
            access_token: accessToken,
            refresh_token: refreshToken || ''
          });

          if (sessionError) {
            console.error('Set session error:', sessionError);
            throw sessionError;
          }

          window.location.href = '/auth/confirmed';
          return;
        }

        // If we get here with a type but no tokens, just redirect to confirmed
        // (Supabase may have already handled verification)
        if (type === 'signup' || type === 'email_change' || type === 'magiclink') {
          console.log('No tokens but valid type, redirecting to confirmed');
          window.location.href = '/auth/confirmed';
          return;
        }

        // No recognizable parameters - redirect home
        console.log('No auth parameters found, redirecting home');
        window.location.href = '/';

      } catch (error) {
        console.error('Auth callback error:', error);
        showError(error.message || 'Verification failed. Please try again.');
      }
    }

    // Add timeout fallback
    setTimeout(() => {
      if (document.getElementById('spinner').style.display !== 'none') {
        showError('Verification timed out. Please try again.');
      }
    }, 15000);

    // Run on page load
    handleAuthCallback();
  </script>

</body>
</html>
