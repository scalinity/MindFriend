import hashlib
import re

def generate_uuid(seed):
    """Generate a 24-char hex UUID based on a seed string"""
    return hashlib.md5(seed.encode()).hexdigest()[:24].upper()

# Read the project file
with open('MindFriendApp.xcodeproj/project.pbxproj', 'r') as f:
    content = f.read()

# Generate UUIDs for the new file
file_ref_uuid = generate_uuid('OurApproachView.swift_fileref')
build_file_uuid = generate_uuid('OurApproachView.swift_buildfile')

print(f"File Ref UUID: {file_ref_uuid}")
print(f"Build File UUID: {build_file_uuid}")

# Find a Profile folder reference line to get the group UUID
profile_match = re.search(r'(\w{24}) /\* Profile \*/ = \{', content)
if profile_match:
    print(f"Found Profile group: {profile_match.group(1)}")

# Find where PrivacyBanner.swift is listed in Profile group
privacy_pattern = r'(\w{24}) /\* PrivacyBanner\.swift \*/'
privacy_match = re.search(privacy_pattern, content)
if privacy_match:
    print(f"Found PrivacyBanner ref: {privacy_match.group(1)}")

# Find the Sources build phase section
sources_match = re.search(r'/\* PrivacyBanner\.swift in Sources \*/ = \{isa = PBXBuildFile; fileRef = (\w{24})', content)
if sources_match:
    print(f"PrivacyBanner file ref in Sources: {sources_match.group(1)}")

# Add the file reference (after PrivacyBanner.swift reference)
file_ref_line = f'\t\t{file_ref_uuid} /* OurApproachView.swift */ = {{isa = PBXFileReference; lastKnownFileType = sourcecode.swift; path = OurApproachView.swift; sourceTree = "<group>"; }};'

# Add the build file entry (after PrivacyBanner.swift build entry)
build_file_line = f'\t\t{build_file_uuid} /* OurApproachView.swift in Sources */ = {{isa = PBXBuildFile; fileRef = {file_ref_uuid} /* OurApproachView.swift */; }};'

# Find insertion points and add
if f'{file_ref_uuid}' not in content:
    # Insert file reference after PrivacyBanner.swift reference
    privacy_ref_pattern = r'(\w{24} /\* PrivacyBanner\.swift \*/ = \{isa = PBXFileReference;[^}]+\};)'
    match = re.search(privacy_ref_pattern, content)
    if match:
        insert_pos = match.end()
        content = content[:insert_pos] + '\n' + file_ref_line + content[insert_pos:]
        print("Added file reference")

    # Insert build file entry after PrivacyBanner.swift build entry
    privacy_build_pattern = r'(\w{24} /\* PrivacyBanner\.swift in Sources \*/ = \{isa = PBXBuildFile;[^}]+\};)'
    match = re.search(privacy_build_pattern, content)
    if match:
        insert_pos = match.end()
        content = content[:insert_pos] + '\n' + build_file_line + content[insert_pos:]
        print("Added build file entry")

    # Add to Profile group children
    # Find the Profile group and add to its children
    profile_children_pattern = r'(/\* Profile \*/ = \{[^}]*children = \([^)]*?)(\);)'
    def add_to_profile(match):
        children = match.group(1)
        # Add before closing parenthesis
        return children + f'\n\t\t\t\t{file_ref_uuid} /* OurApproachView.swift */,' + match.group(2)
    
    content = re.sub(profile_children_pattern, add_to_profile, content, count=1)
    print("Added to Profile group")

    # Add to Sources build phase
    sources_phase_pattern = r'(files = \([^)]*PrivacyBanner\.swift in Sources[^,]*,)'
    def add_to_sources(match):
        return match.group(1) + f'\n\t\t\t\t{build_file_uuid} /* OurApproachView.swift in Sources */,'
    
    content = re.sub(sources_phase_pattern, add_to_sources, content, count=1)
    print("Added to Sources build phase")

    # Write the modified content
    with open('MindFriendApp.xcodeproj/project.pbxproj', 'w') as f:
        f.write(content)
    print("Project file updated!")
else:
    print("File already in project")

