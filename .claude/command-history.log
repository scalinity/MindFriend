sources_phase = main_target.source_build_phase

new_files.each do |file_path|
  components = file_path.split("/")
  filename = components.pop
  
  # Navigate to the correct group
  current_group = main_group
  components.each do |component|
    found_group = current_group.groups.find { |g| g.path == component || g.name == component }
    if found_group
      current_group = found_group
    end
  end
  
  # Check if file already exists in project
  existing = current_group.files.find { |f| f.path == filename }
  unless existing
    file_ref = current_group.new_file(file_path)
    sources_phase.add_file_reference(file_ref)
    puts "Added: #{file_path}"
  else
    puts "Already exists: #{file_path}"
  end
end

project.save
puts "Project saved successfully"
