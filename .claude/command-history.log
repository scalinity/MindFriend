import re
import uuid

# Read the project file
with open('MindFriendApp.xcodeproj/project.pbxproj', 'r') as f:
    content = f.read()

# Generate unique 24-char hex IDs
build_id = 'M3M0RY' + uuid.uuid4().hex[:18].upper()
ref_id = 'MSET1N' + uuid.uuid4().hex[:18].upper()

# 1. Add PBXFileReference (after ProfileView.swift reference)
profile_ref_pattern = r'(82200F5D3BA38777360CDF95 /\* ProfileView\.swift \*/ = \{isa = PBXFileReference.*?\};)'
ref_entry = f'\n\t\t{ref_id} /* MemorySettingsView.swift */ = {{isa = PBXFileReference; lastKnownFileType = sourcecode.swift; path = MemorySettingsView.swift; sourceTree = "<group>"; }};'
content = re.sub(profile_ref_pattern, r'\1' + ref_entry, content)

# 2. Add PBXBuildFile (after ProfileView.swift build file)
profile_build_pattern = r'(5F9209BCB7442D68F9FB9951 /\* ProfileView\.swift in Sources \*/ = \{isa = PBXBuildFile.*?\};)'
build_entry = f'\n\t\t{build_id} /* MemorySettingsView.swift in Sources */ = {{isa = PBXBuildFile; fileRef = {ref_id} /* MemorySettingsView.swift */; }};'
content = re.sub(profile_build_pattern, r'\1' + build_entry, content)

# 3. Add to Profile group children (after ProfileView.swift in children list)
# Find the Profile group's children array
children_pattern = r'(82200F5D3BA38777360CDF95 /\* ProfileView\.swift \*/,)'
children_entry = f'\n\t\t\t\t{ref_id} /* MemorySettingsView.swift */,'
content = re.sub(children_pattern, r'\1' + children_entry, content)

# 4. Add to Sources build phase (after ProfileView.swift in Sources)
sources_pattern = r'(5F9209BCB7442D68F9FB9951 /\* ProfileView\.swift in Sources \*/,)'
sources_entry = f'\n\t\t\t\t{build_id} /* MemorySettingsView.swift in Sources */,'
content = re.sub(sources_pattern, r'\1' + sources_entry, content)

# Write back
with open('MindFriendApp.xcodeproj/project.pbxproj', 'w') as f:
    f.write(content)

print(f"Added MemorySettingsView.swift to project")
print(f"File ref ID: {ref_id}")
print(f"Build file ID: {build_id}")
EOF
