  "MindFriendApp/Features/Exercises/EvidenceBadge.swift",
  "MindFriendApp/Features/Exercises/MethodologyInfoSheet.swift",
  "MindFriendApp/Features/Profile/PrivacyBanner.swift",
  "MindFriendApp/Features/Profile/OurApproachView.swift",
  "MindFriendApp/Features/Onboarding/TestimonialsCarousel.swift"
]

