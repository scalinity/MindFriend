content = File.read("MindFriendApp.xcodeproj/project.pbxproj")

# Files to remove (base names without path)
files_to_remove = [
  "KeychainManager.swift",
  "APIEndpoint.swift",
  "CircleService.swift",
  "SessionManager.swift",
  "UserService.swift",
  "CertificatePinning.swift",
  "ExerciseService.swift",
  "MoodService.swift",
  "AuthService.swift",
  "APIClient.swift",
  "QuestService.swift"
]

# Remove PBXBuildFile entries (lines containing "in Sources" with these file names)
files_to_remove.each do |file|
  content.gsub!(/^\s*[A-F0-9]+ \/\* #{Regexp.escape(file)} in Sources \*\/ = \{isa = PBXBuildFile;.*\};\n/, "")
end

# Remove PBXFileReference entries
files_to_remove.each do |file|
  content.gsub!(/^\s*[A-F0-9]+ \/\* #{Regexp.escape(file)} \*\/ = \{isa = PBXFileReference;.*\};\n/, "")
end

# Remove from group children lists (file references in groups)
files_to_remove.each do |file|
  content.gsub!(/^\s*[A-F0-9]+ \/\* #{Regexp.escape(file)} \*\/,\n/, "")
end

File.write("MindFriendApp.xcodeproj/project.pbxproj", content)
puts "Project file cleaned"
'
[2026-01-13 01:18:51] python3 << 'PYEOF'
import re

with open("MindFriendApp.xcodeproj/project.pbxproj", "r") as f:
    content = f.read()

# Files to remove
files_to_remove = [
    "KeychainManager.swift",
    "APIEndpoint.swift",
    "CircleService.swift",
    "SessionManager.swift",
    "UserService.swift",
    "CertificatePinning.swift",
    "ExerciseService.swift",
    "MoodService.swift",
    "AuthService.swift",
    "APIClient.swift",
    "QuestService.swift"
]

for filename in files_to_remove:
    # Remove PBXBuildFile entries
    pattern = rf'^\s*[A-F0-9]+ /\* {re.escape(filename)} in Sources \*/ = \{{isa = PBXBuildFile;.*?\}};\n'
    content = re.sub(pattern, '', content, flags=re.MULTILINE)
    
    # Remove PBXFileReference entries
    pattern = rf'^\s*[A-F0-9]+ /\* {re.escape(filename)} \*/ = \{{isa = PBXFileReference;.*?\}};\n'
    content = re.sub(pattern, '', content, flags=re.MULTILINE)
    
    # Remove from group children (with trailing comma)
    pattern = rf'^\s*[A-F0-9]+ /\* {re.escape(filename)} \*/,\n'
    content = re.sub(pattern, '', content, flags=re.MULTILINE)

with open("MindFriendApp.xcodeproj/project.pbxproj", "w") as f:
    f.write(content)

print("Project file updated successfully")
PYEOF
