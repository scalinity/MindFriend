<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>MindFriend</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>MindFriend</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.937820575713-afr6c9u3mtle5emk9aefa1fiosojfmbg</string>
				<string>com.googleusercontent.apps.937820575713-3n91aim648r7vhjr9iojm08opbp84c1n</string>
				<string>mindfriend</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>GOOGLE_CLIENT_ID</key>
	<string>$(GOOGLE_CLIENT_ID)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>MindFriend monitors your calendar to proactively offer calming interventions before stressful events like meetings and deadlines.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>MindFriend can add wellness reminders and quest schedules to your calendar.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>MindFriend can add wellness reminders and quest schedules to your calendar.</string>
	<key>NSCameraUsageDescription</key>
	<string>MindFriend uses the camera to let you add photos to your journal entries and profile.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>MindFriend uses Face ID to securely unlock your private journal and mood data.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>MindFriend reads sleep, heart rate, heart rate variability, resting heart rate, breathing rate, steps, distance, active energy, exercise and mindful minutes, and workouts to show your sleep and wellness trends and to time suggestions well.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>During heart-rate biofeedback, MindFriend starts a workout session so it can read your heart rate live. It does not save workouts or other data to Health.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright 2024 MindFriend. All rights reserved.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>MindFriend uses your location to provide context-aware wellness suggestions based on your environment.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>MindFriend uses the microphone for voice journaling and guided meditation recordings.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>MindFriend needs access to your photos to let you add images to your journal entries and profile.</string>
	<key>SENTRY_DSN</key>
	<string>$(SENTRY_DSN)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
