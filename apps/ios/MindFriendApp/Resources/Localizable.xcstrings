        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se voce esta em perigo imediato, ligue para seus servicos de emergencia locais (911 nos EUA)"
          }
        }
      }
    },
    "If you need immediate support:" : {
      "comment" : "A heading for a section that reminds users of crisis resources.",
