        }
      }
    },
    "MindFriend is not a replacement for professional mental health care. If you're experiencing a crisis or need clinical support, please contact a mental health professional." : {
      "comment" : "A disclaimer explaining that MindFriend is not a substitute for professional mental health care. It also includes a suggestion for users to contact a mental health professional if they are in crisis or need support.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MindFriend no es un reemplazo de la atencion profesional de salud mental. Si estas experimentando una crisis o necesitas apoyo clinico, por favor contacta a un profesional de salud mental."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MindFriend nao e um substituto para cuidados profissionais de saude mental. Se voce esta passando por uma crise ou precisa de apoio clinico, por favor entre em contato com um profissional de saude mental."
