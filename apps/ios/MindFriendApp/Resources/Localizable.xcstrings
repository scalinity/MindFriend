    "We need a bit more data to create meaningful patterns. Keep tracking for at least 7 days." : {
      "comment" : "A message displayed when the user does not have enough data to generate a stress signature. It encourages the user to track their moods for at least 7 days.",
      "isCommentAutoGenerated" : true
    },
    "We won't send notifications during quiet hours. Default is 10 PM to 7 AM." : {
      "comment" : "An explanatory text below the quiet hours configuration form, describing the default time range.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No enviaremos notificaciones durante las horas tranquilas. El predeterminado es de 10 PM a 7 AM."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nao enviaremos notificacoes durante as horas silenciosas. O padrao e das 22h as 7h."
          }
        }
      }
    },
    "We'll never send more than this many proactive messages per day." : {
      "comment" : "A footer text in the Proactive Settings view, explaining that the maximum number of proactive messages a user can receive per day is capped at 5.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca enviaremos mas de esta cantidad de mensajes proactivos por dia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca enviaremos mais do que essa quantidade de mensagens proativas por dia."
          }
        }
      }
    },
    "We'll notify you when matched." : {
      "comment" : "A description of what will happen once a user is matched with a listener.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te notificaremos cuando seas emparejado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notificaremos voce quando for correspondido."
          }
        }
      }
    },
    "We'll remind you to complete your daily program content at this time." : {
      "comment" : "A description under the time picker in the Enrollment Sheet, explaining that the app will remind the user to complete their daily program content at the selected time.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te recordaremos completar tu contenido del programa diario a esta hora."
          }
