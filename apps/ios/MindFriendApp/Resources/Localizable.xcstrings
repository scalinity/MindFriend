    "MindFriend %@" : {
      "comment" : "The subject line of a share sheet that includes the name of the report type.",
      "isCommentAutoGenerated" : true
    },
    "MindFriend automatically remembers details from your conversations to provide more personalized support." : {
      "comment" : "A description of how MindFriend remembers user details.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MindFriend recuerda automaticamente detalles de tus conversaciones para proporcionar un apoyo mas personalizado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MindFriend lembra automaticamente detalhes das suas conversas para fornecer suporte mais personalizado."
          }
        }
      }
    },
    "MindFriend can analyze your patterns to predict when you might need extra support, and reach out proactively with helpful resources." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MindFriend puede analizar tus patrones para predecir cuando podrias necesitar apoyo adicional, y comunicarse proactivamente con recursos utiles."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MindFriend pode analisar seus padroes para prever quando voce pode precisar de apoio extra, e entrar em contato proativamente com recursos uteis."
          }
        }
      }
    },
    "MindFriend can proactively reach out to support you based on your patterns and activity." : {
      "comment" : "A description of the proactive feature, explaining its purpose and benefits.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MindFriend puede comunicarse proactivamente para apoyarte segun tus patrones y actividad."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MindFriend pode entrar em contato proativamente para apoia-lo com base nos seus padroes e atividade."
          }
        }
      }
    },
    "MindFriend can read your health data to provide personalized insights about how your physical wellness affects your mood." : {
      "comment" : "An explanatory text about how MindFriend uses health data to provide personalized insights.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MindFriend puede leer tus datos de salud para proporcionar perspectivas personalizadas sobre como tu bienestar fisico afecta tu estado de animo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
