// Release.xcconfig.sample
// Copy this file to Release.xcconfig and fill in your production credentials
// DO NOT commit Release.xcconfig to version control!

// Supabase Production Configuration
// IMPORTANT: xcconfig treats // as comment delimiter, so we must escape URLs
// We split the URL into protocol and host, then use :/$()/ to create ://
SUPABASE_PROTOCOL = https
SUPABASE_HOST = your-project.supabase.co
SUPABASE_URL = $(SUPABASE_PROTOCOL):/$()/$(SUPABASE_HOST)
SUPABASE_ANON_KEY = your-production-anon-key-here

// Note: For CI/CD, set these as environment variables in your build system
// The build script should generate Release.xcconfig from environment variables
