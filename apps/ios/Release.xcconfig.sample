// Release.xcconfig.sample
// Copy this file to Release.xcconfig and fill in your production credentials
// DO NOT commit Release.xcconfig to version control!

// Supabase Production Configuration
SLASH = /
SUPABASE_PROTOCOL = https
SUPABASE_HOST = YOUR_SUPABASE_PROJECT.supabase.co
SUPABASE_URL = $(SUPABASE_PROTOCOL):$(SLASH)$(SLASH)$(SUPABASE_HOST)
SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_KEY_HERE

// Google OAuth Client ID (iOS client from https://console.cloud.google.com/apis/credentials)
// Format: <project-number>-<hash>.apps.googleusercontent.com
// MUST be the iOS OAuth client, not the Supabase web client.
GOOGLE_CLIENT_ID = YOUR_IOS_GOOGLE_CLIENT_ID.apps.googleusercontent.com

// Sentry Crash Reporting (required for production)
SENTRY_DSN = https://YOUR_PUBLIC_KEY@YOUR_ORG.ingest.sentry.io/YOUR_PROJECT_ID
