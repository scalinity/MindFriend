// Debug.xcconfig.sample
// Copy this file to Debug.xcconfig and fill in your development credentials
// DO NOT commit Debug.xcconfig to version control!

// Supabase Configuration
SLASH = /
SUPABASE_PROTOCOL = https
SUPABASE_HOST = YOUR_SUPABASE_PROJECT.supabase.co
SUPABASE_URL = $(SUPABASE_PROTOCOL):$(SLASH)$(SLASH)$(SUPABASE_HOST)
SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_KEY_HERE

// Sentry Crash Reporting (optional for development)
// Leave empty to disable, or set to your Sentry DSN
SENTRY_DSN =
