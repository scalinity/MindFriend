// Debug.xcconfig.sample
// Copy this file to Debug.xcconfig and fill in your credentials
// DO NOT commit Debug.xcconfig to version control!

// Supabase Configuration
// IMPORTANT: Use $()/ to escape // in URLs - xcconfig treats // as comment delimiter!
// Example: https:/$()/your-project.supabase.co (NOT https://your-project.supabase.co)
SUPABASE_URL = https:/$()/your-project.supabase.co
SUPABASE_ANON_KEY = your-anon-key-here

// For local development with supabase local, use:
// SUPABASE_URL = http:/$()/localhost:54321
// SUPABASE_ANON_KEY = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
