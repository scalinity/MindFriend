# ===========================================
# MindFriend API - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# -----------------
# Core Application
# -----------------
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
API_VERSION=v1

# -----------------
# Database
# -----------------
DATABASE_URL=postgresql://mindfriend:mindfriend_dev@localhost:5432/mindfriend
# Production: postgresql://user:password@host:5432/mindfriend?sslmode=require

# -----------------
# Redis
# -----------------
REDIS_URL=redis://localhost:6379
# Production: redis://:password@host:6379

# -----------------
# JWT Authentication
# -----------------
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-min-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# -----------------
# Apple Sign In
# -----------------
APPLE_AUDIENCE=com.yourcompany.mindfriend
APPLE_ISSUER=https://appleid.apple.com
# Set to 'true' to use mock authentication in development
APPLE_AUTH_MOCK=true

# -----------------
# APNs (Push Notifications)
# -----------------
APNS_TEAM_ID=XXXXXXXXXX
APNS_KEY_ID=YYYYYYYYYY
APNS_BUNDLE_ID=com.yourcompany.mindfriend
# Base64 encoded .p8 file content
APNS_PRIVATE_KEY_P8_BASE64=
# Environment: 'production' or 'development'
APNS_ENVIRONMENT=development
# Set to 'true' to use mock push notifications
APNS_MOCK=true

# -----------------
# AI Provider (OpenAI)
# -----------------
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
AI_REQUEST_TIMEOUT_MS=30000

# AI Rate Limiting
AI_DAILY_FREE_QUOTA=20

# -----------------
# App Store / StoreKit 2
# -----------------
# App Store Server API credentials
APPLE_APPSTORE_PRIVATE_KEY_BASE64=
APPLE_APPSTORE_KEY_ID=
APPLE_APPSTORE_ISSUER_ID=
APPLE_BUNDLE_ID=com.yourcompany.mindfriend
# Environment: 'Production' or 'Sandbox'
APPLE_APPSTORE_ENVIRONMENT=Sandbox
# Set to 'true' to use mock billing
APPLE_BILLING_MOCK=true

# -----------------
# S3 Storage (Audio Assets)
# -----------------
S3_BUCKET=mindfriend-assets
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# For local development with LocalStack
S3_ENDPOINT=http://localhost:4566
CDN_BASE_URL=http://localhost:4566/mindfriend-assets

# -----------------
# Observability
# -----------------
SENTRY_DSN=
LOG_LEVEL=debug

# -----------------
# Rate Limiting
# -----------------
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_CHAT_LIMIT=60

# -----------------
# Encryption
# -----------------
# 32-byte key for field-level encryption (mood notes, reflections)
ENCRYPTION_KEY=dev-encryption-key-32-bytes-long!
