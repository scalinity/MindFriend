// MindFriend Database Schema
// Based on MindFriend-spec.md Section 4: Data Model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== USERS & AUTH ====================

model User {
  id          String    @id @default(uuid()) @db.Uuid
  handle      String    @unique @db.VarChar(24)
  displayName String    @map("display_name") @db.VarChar(40)
  email       String?   @db.VarChar(255)
  birthdate   DateTime? @db.Date
  countryCode String?   @map("country_code") @db.Char(2)
  timezone    String    @default("UTC") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  authIdentities    AuthIdentity[]
  devices           Device[]
  settings          UserSettings?
  stats             UserStats?
  subscriptions     Subscription[]
  conversations     Conversation[]
  messages          Message[]
  moodEntries       MoodEntry[]
  questInstances    QuestInstance[]
  questCompletions  QuestCompletion[]
  userBadges        UserBadge[]
  ownedCircles      Circle[]          @relation("CircleOwner")
  circleMemberships CircleMember[]
  circlePosts       CirclePost[]
  exerciseSessions  ExerciseSession[]
  notifications     Notification[]
  crisisEvents      CrisisEvent[]
  refreshTokens     RefreshToken[]
  dailyAiUsage      DailyAiUsage[]

  @@index([createdAt])
  @@map("users")
}

model AuthIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String   @db.VarChar(16) // apple
  providerSubject String   @map("provider_subject") @db.VarChar(128)
  email           String?  @db.VarChar(255)
  emailVerified   Boolean  @default(false) @map("email_verified")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @map("token_hash") @db.VarChar(128)
  deviceId     String?   @map("device_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  device         Device?       @relation(fields: [deviceId], references: [id])
  replacedBy     RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id])
  replacedTokens RefreshToken[] @relation("TokenRotation")

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Device {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  platform    String   @default("ios") @db.VarChar(16)
  deviceModel String?  @map("device_model") @db.VarChar(64)
  osVersion   String?  @map("os_version") @db.VarChar(32)
  locale      String   @default("en-US") @db.VarChar(16)
  timezone    String   @db.VarChar(64)
  apnsToken   String?  @unique @map("apns_token") @db.VarChar(200)
  pushEnabled Boolean  @default(true) @map("push_enabled")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("devices")
}

model UserSettings {
  userId                 String    @id @map("user_id") @db.Uuid
  dailyQuestTimeLocal    String    @default("09:00:00") @map("daily_quest_time_local") @db.VarChar(8)
  quietHoursStartLocal   String?   @map("quiet_hours_start_local") @db.VarChar(8)
  quietHoursEndLocal     String?   @map("quiet_hours_end_local") @db.VarChar(8)
  remindersEnabled       Boolean   @default(true) @map("reminders_enabled")
  nudgeAfterDaysInactive Int       @default(2) @map("nudge_after_days_inactive")
  shareMoodInCircles     Boolean   @default(true) @map("share_mood_in_circles")
  aiTone                 String    @default("friendly") @map("ai_tone") @db.VarChar(16)
  privacyMode            String    @default("standard") @map("privacy_mode") @db.VarChar(16)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserStats {
  userId                  String    @id @map("user_id") @db.Uuid
  currentStreakDays       Int       @default(0) @map("current_streak_days")
  longestStreakDays       Int       @default(0) @map("longest_streak_days")
  lastStreakLocalDate     String?   @map("last_streak_local_date") @db.VarChar(10)
  totalQuestsCompleted    Int       @default(0) @map("total_quests_completed")
  totalExercisesCompleted Int       @default(0) @map("total_exercises_completed")
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

// ==================== SUBSCRIPTIONS & BILLING ====================

model Subscription {
  id                    String             @id @default(uuid()) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  productId             String             @map("product_id") @db.VarChar(64)
  status                SubscriptionStatus
  currentPeriodEnd      DateTime?          @map("current_period_end") @db.Timestamptz
  originalTransactionId String?            @map("original_transaction_id") @db.VarChar(64)
  latestTransactionId   String?            @map("latest_transaction_id") @db.VarChar(64)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  active
  grace
  expired
  canceled
}

// ==================== AI CHAT ====================

model Conversation {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  title     String?            @db.VarChar(64)
  status    ConversationStatus @default(active)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@map("conversations")
}

enum ConversationStatus {
  active
  archived
}

model Message {
  id                String           @id @default(uuid()) @db.Uuid
  conversationId    String           @map("conversation_id") @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  role              MessageRole
  content           String           @db.Text
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  moderationLabel   ModerationLabel? @map("moderation_label")
  blocked           Boolean          @default(false)
  tokenIn           Int?             @map("token_in")
  tokenOut          Int?             @map("token_out")
  providerMessageId String?          @map("provider_message_id") @db.VarChar(128)

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  crisisEvents CrisisEvent[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

enum MessageRole {
  user
  assistant
  system
}

enum ModerationLabel {
  ok
  self_harm
  violence
  sexual
  minors
  hate
  unknown
}

model DailyAiUsage {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  localDate    String   @map("local_date") @db.VarChar(10)
  messageCount Int      @default(0) @map("message_count")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate])
  @@map("daily_ai_usage")
}

// ==================== MOODS ====================

model MoodEntry {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  localDate    String     @map("local_date") @db.VarChar(10)
  moodScore    Int        @map("mood_score") @db.SmallInt
  anxietyScore Int?       @map("anxiety_score") @db.SmallInt
  energyScore  Int?       @map("energy_score") @db.SmallInt
  note         String?    @db.Text
  source       MoodSource @default(manual)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate, source])
  @@index([userId, localDate])
  @@map("mood_entries")
}

enum MoodSource {
  manual
  quest
  circle_checkin
}

// ==================== QUESTS ====================

model QuestTemplate {
  id               String   @id @default(uuid()) @db.Uuid
  type             String   @db.VarChar(32)
  title            String   @db.VarChar(64)
  description      String   @db.VarChar(240)
  estimatedMinutes Int      @map("estimated_minutes") @db.SmallInt
  difficulty       Int      @db.SmallInt
  tags             String[] @default([])
  instructionsJson Json     @map("instructions_json")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  questInstances QuestInstance[]

  @@index([type])
  @@index([active])
  @@map("quest_templates")
}

model QuestInstance {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @map("user_id") @db.Uuid
  templateId          String              @map("template_id") @db.Uuid
  localDate           String              @map("local_date") @db.VarChar(10)
  status              QuestInstanceStatus @default(assigned)
  personalizationJson Json                @default("{}") @map("personalization_json")
  assignedAt          DateTime            @default(now()) @map("assigned_at") @db.Timestamptz
  completedAt         DateTime?           @map("completed_at") @db.Timestamptz

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   QuestTemplate    @relation(fields: [templateId], references: [id])
  completion QuestCompletion?

  @@unique([userId, localDate])
  @@index([userId, localDate])
  @@map("quest_instances")
}

enum QuestInstanceStatus {
  assigned
  completed
  skipped
  expired
}

model QuestCompletion {
  id              String   @id @default(uuid()) @db.Uuid
  questInstanceId String   @unique @map("quest_instance_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  reflectionNote  String?  @map("reflection_note") @db.Text
  rating          Int?     @db.SmallInt
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  questInstance QuestInstance @relation(fields: [questInstanceId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quest_completions")
}

// ==================== BADGES ====================

model Badge {
  id           String  @id @default(uuid()) @db.Uuid
  code         String  @unique @db.VarChar(32)
  title        String  @db.VarChar(64)
  description  String  @db.VarChar(240)
  criteriaJson Json    @map("criteria_json")
  active       Boolean @default(true)

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId   String   @map("user_id") @db.Uuid
  badgeId  String   @map("badge_id") @db.Uuid
  earnedAt DateTime @default(now()) @map("earned_at") @db.Timestamptz

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@map("user_badges")
}

// ==================== CIRCLES ====================

model Circle {
  id          String   @id @default(uuid()) @db.Uuid
  ownerUserId String   @map("owner_user_id") @db.Uuid
  name        String   @db.VarChar(40)
  description String?  @db.VarChar(160)
  isPrivate   Boolean  @default(true) @map("is_private")
  inviteCode  String   @unique @map("invite_code") @db.VarChar(12)
  maxMembers  Int      @default(8) @map("max_members") @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  owner   User           @relation("CircleOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members CircleMember[]
  posts   CirclePost[]

  @@index([inviteCode])
  @@map("circles")
}

model CircleMember {
  circleId String           @map("circle_id") @db.Uuid
  userId   String           @map("user_id") @db.Uuid
  role     CircleMemberRole @default(member)
  status   String           @default("active") @db.VarChar(16)
  joinedAt DateTime         @default(now()) @map("joined_at") @db.Timestamptz

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([circleId, userId])
  @@map("circle_members")
}

enum CircleMemberRole {
  owner
  member
}

model CirclePost {
  id        String         @id @default(uuid()) @db.Uuid
  circleId  String         @map("circle_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  kind      CirclePostKind
  moodEmoji String?        @map("mood_emoji") @db.VarChar(8)
  bodyText  String?        @map("body_text") @db.VarChar(280)
  localDate String         @map("local_date") @db.VarChar(10)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId, localDate, kind])
  @@index([circleId, localDate])
  @@map("circle_posts")
}

enum CirclePostKind {
  checkin
  achievement
  reflection
}

// ==================== EXERCISES ====================

model Exercise {
  id              String      @id @default(uuid()) @db.Uuid
  type            String      @db.VarChar(24)
  title           String      @db.VarChar(64)
  description     String      @db.VarChar(240)
  durationSeconds Int         @map("duration_seconds")
  contentKind     ContentKind @map("content_kind")
  contentText     String?     @map("content_text") @db.Text
  audioUrl        String?     @map("audio_url") @db.Text
  tags            String[]    @default([])
  active          Boolean     @default(true)

  sessions ExerciseSession[]

  @@index([type])
  @@index([active])
  @@map("exercises")
}

enum ContentKind {
  text
  audio
}

model ExerciseSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  exerciseId String    @map("exercise_id") @db.Uuid
  startedAt  DateTime  @map("started_at") @db.Timestamptz
  endedAt    DateTime? @map("ended_at") @db.Timestamptz
  completed  Boolean   @default(false)
  rating     Int?      @db.SmallInt
  note       String?   @db.Text

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@index([userId])
  @@map("exercise_sessions")
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  deviceId    String?            @map("device_id") @db.Uuid
  type        NotificationType
  title       String             @db.VarChar(64)
  body        String             @db.VarChar(160)
  dataJson    Json               @default("{}") @map("data_json")
  scheduledAt DateTime           @map("scheduled_at") @db.Timestamptz
  sentAt      DateTime?          @map("sent_at") @db.Timestamptz
  status      NotificationStatus @default(scheduled)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("notifications")
}

enum NotificationType {
  daily_quest
  inactivity_nudge
  circle_activity
}

enum NotificationStatus {
  scheduled
  sent
  failed
  canceled
}

// ==================== CRISIS & SAFETY ====================

model CrisisEvent {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  severity     CrisisSeverity
  source       CrisisSource
  messageId    String?        @map("message_id") @db.Uuid
  detectedAt   DateTime       @default(now()) @map("detected_at") @db.Timestamptz
  actionTaken  CrisisAction   @map("action_taken")
  metadataJson Json           @default("{}") @map("metadata_json")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id])

  @@index([userId, detectedAt])
  @@map("crisis_events")
}

enum CrisisSeverity {
  low
  medium
  high
}

enum CrisisSource {
  ai_input
  ai_output
  mood_entry
  user_action
}

enum CrisisAction {
  show_resources
  block_response
  handoff_message
}

// ==================== CRISIS RESOURCES ====================

model CrisisResource {
  id          String   @id @default(uuid()) @db.Uuid
  countryCode String   @map("country_code") @db.VarChar(10)
  name        String   @db.VarChar(100)
  contact     String   @db.VarChar(200)
  kind        String   @db.VarChar(20) // phone, text, website
  description String?  @db.VarChar(255)
  priority    Int      @default(100)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([countryCode])
  @@map("crisis_resources")
}
